# Server Configuration
NODE_ENV=production
PORT=3000

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/doha-marathon

# Dashboard Authentication (set these in Render Environment Variables)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here

# Session Secret
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.onrender.com